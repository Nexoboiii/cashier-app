# leading slash = repo root only. without it a pattern matches at EVERY level,
# which is how config/ once swallowed the java config package.

# --- build output ---
/target/
!**/src/main/**/target/
!**/src/test/**/target/
node_modules/
/frontend/dist/

# --- vite build output: generated, never hand-edited ---
/src/main/resources/static/

# --- maven wrapper: jar is downloaded, not committed ---
/.mvn/wrapper/maven-wrapper.jar

# --- node installed by frontend-maven-plugin ---
/frontend/node/

# --- runtime data: lives in Desktop\comic-con_stuff\till\ ---
/data/
/backups/
*.mv.db
*.trace.db

# --- logs ---
/logs/
*.log

# --- machine config: commit config.example.properties instead ---
/config/
.env

# --- cypress artefacts (Phase 3c) ---
/frontend/cypress/screenshots/
/frontend/cypress/videos/
/frontend/cypress/downloads/

# --- spring initializr leftovers ---
/HELP.md

# --- IDE ---
.idea
*.iml
*.iws
*.ipr
.vscode/
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
