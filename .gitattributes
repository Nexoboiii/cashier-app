# normalise line endings: LF in repo, native on checkout
* text=auto

# mvnw must be LF or the Linux CI runner won't execute it
/mvnw    text eol=lf
*.sh     text eol=lf
*.cmd    text eol=crlf
*.bat    text eol=crlf

*.java   text
*.js     text
*.jsx    text
*.json   text
*.xml    text
*.md     text
*.yml    text
*.properties text

*.png    binary
*.ico    binary
*.jar    binary
*.zip    binary
